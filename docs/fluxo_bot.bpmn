<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Defs_CicloAlerta" targetNamespace="http://cicloalerta/rpa">
  <bpmn:process id="Bot_Triagem" name="Bot de triagem e alertas do CicloAlerta" isExecutable="false">
    <bpmn:startEvent id="Inicio" name="A cada hora">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="BuscarRelatos" name="Buscar relatos (GET /api/relatos, até 3 tentativas)"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Api" name="API do MVP respondeu?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="RegistrarFalha" name="Registrar falha no log e em execucoes.jsonl"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="FimFalha" name="Falha (código 1)"><bpmn:incoming>F5</bpmn:incoming><bpmn:errorEventDefinition id="Erro1" /></bpmn:endEvent>
    <bpmn:task id="Validar" name="Validar cada relato (inválidos vão para a quarentena)"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:standardLoopCharacteristics /></bpmn:task>
    <bpmn:task id="Deduplicar" name="Unir duplicados (mesmo tipo a até 25 m)"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="Clima" name="Consultar chuva prevista por região (Open-Meteo, 3 h)"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:standardLoopCharacteristics /></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Clima" name="Open-Meteo respondeu?"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="UsarCache" name="Usar última previsão salva (marca previsão antiga)"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G_Junta1"><bpmn:incoming>F9</bpmn:incoming><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="ParaCadaPerigo" name="Para cada perigo">
      <bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
      <bpmn:startEvent id="SP_Inicio"><bpmn:outgoing>F13</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="G_Nivel" name="Severidade e chuva?"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="Critico" name="Criar alerta crítico"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:businessRuleTask>
      <bpmn:businessRuleTask id="Atencao" name="Criar alerta de atenção"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:businessRuleTask>
      <bpmn:task id="SemAlerta" name="Sem alerta (só consolida)"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="G_Junta2"><bpmn:incoming>F17</bpmn:incoming><bpmn:incoming>F18</bpmn:incoming><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP_Fim"><bpmn:incoming>F20</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="F13" sourceRef="SP_Inicio" targetRef="G_Nivel" />
      <bpmn:sequenceFlow id="F14" name="alta e chuva ≥ 1 mm" sourceRef="G_Nivel" targetRef="Critico" />
      <bpmn:sequenceFlow id="F15" name="média e chuva ≥ 1 mm" sourceRef="G_Nivel" targetRef="Atencao" />
      <bpmn:sequenceFlow id="F16" name="demais casos" sourceRef="G_Nivel" targetRef="SemAlerta" />
      <bpmn:sequenceFlow id="F17" sourceRef="Critico" targetRef="G_Junta2" />
      <bpmn:sequenceFlow id="F18" sourceRef="Atencao" targetRef="G_Junta2" />
      <bpmn:sequenceFlow id="F19" sourceRef="SemAlerta" targetRef="G_Junta2" />
      <bpmn:sequenceFlow id="F20" sourceRef="G_Junta2" targetRef="SP_Fim" />
    </bpmn:subProcess>
    <bpmn:task id="Gravar" name="Gravar alertas.json, perigos_consolidados.csv (SP156) e quarentena"><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="Publicar" name="Publicar alertas no MVP (POST /api/alertas)"><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Pub" name="Publicou?"><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing><bpmn:outgoing>F25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="FimOk" name="Sucesso (código 0)"><bpmn:incoming>F24</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="RegistrarParcial" name="Registrar erro; integração segue pelo arquivo"><bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="FimParcial" name="Sucesso parcial (código 2)"><bpmn:incoming>F26</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="BuscarRelatos" />
    <bpmn:sequenceFlow id="F2" sourceRef="BuscarRelatos" targetRef="G_Api" />
    <bpmn:sequenceFlow id="F3" name="sim" sourceRef="G_Api" targetRef="Validar" />
    <bpmn:sequenceFlow id="F4" name="não" sourceRef="G_Api" targetRef="RegistrarFalha" />
    <bpmn:sequenceFlow id="F5" sourceRef="RegistrarFalha" targetRef="FimFalha" />
    <bpmn:sequenceFlow id="F6" sourceRef="Validar" targetRef="Deduplicar" />
    <bpmn:sequenceFlow id="F7" sourceRef="Deduplicar" targetRef="Clima" />
    <bpmn:sequenceFlow id="F8" sourceRef="Clima" targetRef="G_Clima" />
    <bpmn:sequenceFlow id="F9" name="sim" sourceRef="G_Clima" targetRef="G_Junta1" />
    <bpmn:sequenceFlow id="F10" name="não" sourceRef="G_Clima" targetRef="UsarCache" />
    <bpmn:sequenceFlow id="F11" sourceRef="UsarCache" targetRef="G_Junta1" />
    <bpmn:sequenceFlow id="F12" sourceRef="G_Junta1" targetRef="ParaCadaPerigo" />
    <bpmn:sequenceFlow id="F21" sourceRef="ParaCadaPerigo" targetRef="Gravar" />
    <bpmn:sequenceFlow id="F22" sourceRef="Gravar" targetRef="Publicar" />
    <bpmn:sequenceFlow id="F23" sourceRef="Publicar" targetRef="G_Pub" />
    <bpmn:sequenceFlow id="F24" name="sim" sourceRef="G_Pub" targetRef="FimOk" />
    <bpmn:sequenceFlow id="F25" name="não" sourceRef="G_Pub" targetRef="RegistrarParcial" />
    <bpmn:sequenceFlow id="F26" sourceRef="RegistrarParcial" targetRef="FimParcial" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama">
    <bpmndi:BPMNPlane id="Plano" bpmnElement="Bot_Triagem">
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio"><dc:Bounds x="100" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BuscarRelatos_di" bpmnElement="BuscarRelatos"><dc:Bounds x="180" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Api_di" bpmnElement="G_Api" isMarkerVisible="true"><dc:Bounds x="340" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="270" y="232" width="70" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RegistrarFalha_di" bpmnElement="RegistrarFalha"><dc:Bounds x="305" y="300" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FimFalha_di" bpmnElement="FimFalha"><dc:Bounds x="347" y="420" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validar_di" bpmnElement="Validar"><dc:Bounds x="440" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Deduplicar_di" bpmnElement="Deduplicar"><dc:Bounds x="600" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Clima_di" bpmnElement="Clima"><dc:Bounds x="760" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Clima_di" bpmnElement="G_Clima" isMarkerVisible="true"><dc:Bounds x="920" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="850" y="232" width="70" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UsarCache_di" bpmnElement="UsarCache"><dc:Bounds x="885" y="300" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Junta1_di" bpmnElement="G_Junta1" isMarkerVisible="true"><dc:Bounds x="1060" y="175" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParaCadaPerigo_di" bpmnElement="ParaCadaPerigo" isExpanded="true"><dc:Bounds x="1150" y="60" width="560" height="290" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Inicio_di" bpmnElement="SP_Inicio"><dc:Bounds x="1180" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Nivel_di" bpmnElement="G_Nivel" isMarkerVisible="true"><dc:Bounds x="1250" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1200" y="232" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Critico_di" bpmnElement="Critico"><dc:Bounds x="1360" y="90" width="140" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Atencao_di" bpmnElement="Atencao"><dc:Bounds x="1360" y="170" width="140" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SemAlerta_di" bpmnElement="SemAlerta"><dc:Bounds x="1360" y="250" width="140" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Junta2_di" bpmnElement="G_Junta2" isMarkerVisible="true"><dc:Bounds x="1550" y="175" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Fim_di" bpmnElement="SP_Fim"><dc:Bounds x="1640" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gravar_di" bpmnElement="Gravar"><dc:Bounds x="1750" y="160" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Publicar_di" bpmnElement="Publicar"><dc:Bounds x="1930" y="160" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Pub_di" bpmnElement="G_Pub" isMarkerVisible="true"><dc:Bounds x="2110" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2075" y="232" width="55" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FimOk_di" bpmnElement="FimOk"><dc:Bounds x="2220" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RegistrarParcial_di" bpmnElement="RegistrarParcial"><dc:Bounds x="2075" y="300" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FimParcial_di" bpmnElement="FimParcial"><dc:Bounds x="2117" y="420" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="200" /><di:waypoint x="180" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="300" y="200" /><di:waypoint x="340" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="390" y="200" /><di:waypoint x="440" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="365" y="225" /><di:waypoint x="365" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="365" y="380" /><di:waypoint x="365" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="560" y="200" /><di:waypoint x="600" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="720" y="200" /><di:waypoint x="760" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="880" y="200" /><di:waypoint x="920" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="970" y="200" /><di:waypoint x="1060" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="945" y="225" /><di:waypoint x="945" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1005" y="340" /><di:waypoint x="1085" y="340" /><di:waypoint x="1085" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1110" y="200" /><di:waypoint x="1150" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1216" y="200" /><di:waypoint x="1250" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1275" y="175" /><di:waypoint x="1275" y="120" /><di:waypoint x="1360" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="1282" y="98" width="75" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="1300" y="200" /><di:waypoint x="1360" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="1300" y="206" width="58" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F16_di" bpmnElement="F16"><di:waypoint x="1275" y="225" /><di:waypoint x="1275" y="280" /><di:waypoint x="1360" y="280" /><bpmndi:BPMNLabel><dc:Bounds x="1282" y="284" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F17_di" bpmnElement="F17"><di:waypoint x="1500" y="120" /><di:waypoint x="1575" y="120" /><di:waypoint x="1575" y="175" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F18_di" bpmnElement="F18"><di:waypoint x="1500" y="200" /><di:waypoint x="1550" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F19_di" bpmnElement="F19"><di:waypoint x="1500" y="280" /><di:waypoint x="1575" y="280" /><di:waypoint x="1575" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F20_di" bpmnElement="F20"><di:waypoint x="1600" y="200" /><di:waypoint x="1640" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F21_di" bpmnElement="F21"><di:waypoint x="1710" y="200" /><di:waypoint x="1750" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F22_di" bpmnElement="F22"><di:waypoint x="1890" y="200" /><di:waypoint x="1930" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F23_di" bpmnElement="F23"><di:waypoint x="2070" y="200" /><di:waypoint x="2110" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F24_di" bpmnElement="F24"><di:waypoint x="2160" y="200" /><di:waypoint x="2220" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F25_di" bpmnElement="F25"><di:waypoint x="2135" y="225" /><di:waypoint x="2135" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F26_di" bpmnElement="F26"><di:waypoint x="2135" y="380" /><di:waypoint x="2135" y="420" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
